generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  local
  microsoft
}

enum UserRole {
  administrator
  privileged_user
  restricted_user
}

model Run {
  id                 String        @id @db.Uuid
  scriptId           String        @map("script_id")
  scriptName         String?       @map("script_name")
  mode               String?
  status             String
  tenantId           String?       @db.Uuid @map("tenant_id")
  tenantHint         String?       @map("tenant_hint")
  requestedBy        String?       @map("requested_by")
  parameters         Json?
  parametersRedacted Json?         @map("parameters_redacted")
  result             Json?
  summary            String?
  exitCode           Int?          @map("exit_code")
  startedAt          DateTime?     @map("started_at")
  finishedAt         DateTime?     @map("finished_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  queuedAt           DateTime?     @map("queued_at")
  lastActivityAt     DateTime?     @map("last_activity_at")
  cancelRequestedAt  DateTime?     @map("cancel_requested_at")
  currentStep        String?       @map("current_step")
  errorSummary       String?       @map("error_summary")
  durationMs         BigInt?       @map("duration_ms")
  command            String?
  commandArgs        Json?         @map("command_args")
  scriptPath         String?       @map("script_path")
  createdByUserId    String?       @db.Uuid @map("created_by_user_id")
  createdByUsername  String?       @map("created_by_username")
  createdByDisplayName String?     @map("created_by_display_name")
  createdByAuthProvider AuthProvider? @map("created_by_auth_provider")
  createdByUser      User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  logs               RunLog[]
  artifacts          RunArtifact[]
  approval           Approval?

  @@index([status, createdAt(sort: Desc)])
  @@index([scriptId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantHint, createdAt(sort: Desc)])
  @@index([requestedBy, createdAt(sort: Desc)])
  @@index([createdByUserId, createdAt(sort: Desc)])
  @@map("runs")
}

model RunLog {
  id        String   @id @db.Uuid
  runId     String   @db.Uuid @map("run_id")
  stream    String
  level     String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("run_logs")
}

model RunArtifact {
  id        String   @id @db.Uuid
  runId     String   @db.Uuid @map("run_id")
  type      String
  filename  String
  path      String
  sizeBytes Int?     @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, path])
  @@index([runId, createdAt])
  @@map("run_artifacts")
}

model Approval {
  id         String   @id @db.Uuid
  runId      String   @unique @db.Uuid @map("run_id")
  status     String
  requestedBy String? @map("requested_by")
  approvedBy String?  @map("approved_by")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("approvals")
}

model Company {
  id        String   @id @db.Uuid
  name      String
  tenant    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name])
  @@unique([tenant])
  @@index([name])
  @@map("companies")
}

model User {
  id                 String       @id @db.Uuid
  username           String       @unique
  passwordHash       String?      @map("password_hash")
  displayName        String?      @map("display_name")
  email              String?      @unique
  authProvider       AuthProvider @map("auth_provider")
  entraObjectId      String?      @unique @map("entra_object_id")
  role               UserRole
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  lastLoginAt        DateTime?    @map("last_login_at")
  runs               Run[]

  @@index([authProvider])
  @@index([role])
  @@map("users")
}

model MicrosoftAuthConfig {
  id           String   @id @default("singleton")
  tenantId     String?  @map("tenant_id")
  clientId     String?  @map("client_id")
  apiClientId  String?  @map("api_client_id")
  authorityUrl String?  @map("authority_url")
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("microsoft_auth_config")
}

model EntraGroupRoleMapping {
  id           String   @id @db.Uuid
  groupName    String   @map("group_name")
  groupId      String?  @unique @map("group_id")
  assignedRole UserRole @map("assigned_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([groupName])
  @@index([assignedRole])
  @@map("entra_group_role_mappings")
}
